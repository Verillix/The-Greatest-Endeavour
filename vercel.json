{
    "builds": [
        {
            "src": "api/*.py",
            "use": "@vercel/python"
        },
        {
            "src": "**/*",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1.py",
            "methods": ["GET", "POST", "OPTIONS"]
        },
        {
            "src": "/(.*)",
            "dest": "/$1"
        }
    ]
}
